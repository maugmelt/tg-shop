# Все настройки этого сервиса — только с префиксом TG_.
# На Render их же вставить в Environment нового сервиса tg-shop.

TG_BOT_TOKEN=
TG_ADMIN_BOT_TOKEN=
TG_WEBHOOK_SECRET=
TG_ADMIN_WEBHOOK_SECRET=
TG_WEBAPP_URL=
